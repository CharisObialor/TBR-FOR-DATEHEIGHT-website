# CORS - comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://tbrsolutions.ng,https://www.tbrsolutions.ng,https://site.tbrsolutions.ng,https://portal.tbrsolutions.ng

# MySQL (resources + newsletter subscribers)
MYSQL_HOST=170.249.219.156
MYSQL_PORT=3306
MYSQL_USER=tjditsgn_CHARIS
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=tjditsgn_TBR

# Recipients who get contact form notifications
CONTACT_RECIPIENTS=admin@tbrsolutions.ng,support@tbrsolutions.ng

# Logo at the top of emails (must be a public HTTPS URL)
EMAIL_LOGO_URL=https://tbrsolutions.ng/images/logo.png
# HELO/EHLO hostname used when connecting to the SMTP server
SMTP_HELO_HOSTNAME=tbrsolutions.ng
# Minimum seconds between duplicate welcome emails to the same address
NEWSLETTER_WELCOME_COOLDOWN=60

# Rate limiting for POST /api/contact (per IP)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# Primary sender (fallback for contact confirmations)
SMTP_HOST=mail.tbrsolutions.ng
SMTP_PORT=465
SMTP_USER=no-reply@tbrsolutions.ng
SMTP_PASSWORD=your-password
FROM_EMAIL=info@tbrsolutions.ng
FROM_NAME=TBR Solutions
SUPPORT_EMAIL=support@tbrsolutions.ng

# Support sender (used for contact notifications + confirmations)
SUPPORT_SMTP_HOST=mail.tbrsolutions.ng
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_USER=support@tbrsolutions.ng
SUPPORT_SMTP_PASSWORD=your-password
SUPPORT_FROM_EMAIL=support@tbrsolutions.ng
